{
  "name": "aether-ai-browser",
  "version": "1.0.0",
  "description": "Next-generation, high-performance web browser with native AI copilot, isolated WebContentsView architecture, vertical workspaces, and built-in privacy protection.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron dist-electron/main.js",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhil-Binu/Aether-AI-Browser.git"
  },
  "keywords": [
    "browser",
    "ai-browser",
    "copilot",
    "electron",
    "react",
    "typescript",
    "adblocker",
    "privacy",
    "vertical-tabs",
    "webcontentsview"
  ],
  "author": "Akhil Binu <AkhilBinuRoom@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
